Bootstrap: docker
From: python:3.9-slim

%files
    ./requirements.txt /app/requirements.txt
    ./ /app/

%post
    cd /app
    pip install --no-cache-dir -r requirements.txt

%runscript
    cd /app
    exec uvicorn main:app --host 0.0.0.0 --port 8004

%environment
    export LC_ALL=C