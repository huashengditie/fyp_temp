Bootstrap: docker
From: python:3.10-slim

%files
    requirements.txt /app/requirements.txt
    main.py /app/main.py

%post
    apt-get update && apt-get install -y --no-install-recommends gcc git build-essential
    pip install --no-cache-dir -r /app/requirements.txt
    echo "Pre-fetching eQuilibrator database cache... This may take a few minutes."
    python -c "from equilibrator_api import ComponentContribution; ComponentContribution()"

%environment
    export HOST=0.0.0.0
    export PORT=8005
    export PYTHONNOUSERSITE=1

%runscript
    cd /app
    exec uvicorn main:app --host 0.0.0.0 --port 8005